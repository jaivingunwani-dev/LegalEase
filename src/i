body {
  margin: 0;
  font-family: Arial, sans-serif;
}

.counter,
.student-result {
  padding: 30px;
}

button {
  padding: 10px 15px;
  margin-right: 10px;
  cursor: pointer;
}

table {
  border-collapse: collapse;
  width: 80%;
}

th,
td {
  border: 1px solid black;
  padding: 10px;
  text-align: center;
}

th {
  background-color: lightgray;
}

hr {
  margin: 20px 30px;
}